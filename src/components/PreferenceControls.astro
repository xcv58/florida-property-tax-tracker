---
---

<div class="preference-controls" aria-label="Display preferences">
  <div class="theme-toggle" role="group" aria-label="Theme">
    <span class="preference-label">Theme</span>
    <button
      type="button"
      data-theme-button
      data-theme-value="system"
      aria-label="System"
      aria-pressed="true"
      title="System"
    >
      <svg class="theme-icon" aria-hidden="true" viewBox="0 0 24 24">
        <rect x="4" y="5" width="16" height="11" rx="2"></rect>
        <path d="M9 20h6"></path>
        <path d="M12 16v4"></path>
      </svg>
    </button>
    <button
      type="button"
      data-theme-button
      data-theme-value="light"
      aria-label="Light"
      aria-pressed="false"
      title="Light"
    >
      <svg class="theme-icon" aria-hidden="true" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2"></path>
        <path d="M12 20v2"></path>
        <path d="m4.93 4.93 1.41 1.41"></path>
        <path d="m17.66 17.66 1.41 1.41"></path>
        <path d="M2 12h2"></path>
        <path d="M20 12h2"></path>
        <path d="m6.34 17.66-1.41 1.41"></path>
        <path d="m19.07 4.93-1.41 1.41"></path>
      </svg>
    </button>
    <button
      type="button"
      data-theme-button
      data-theme-value="dark"
      aria-label="Dark"
      aria-pressed="false"
      title="Dark"
    >
      <svg class="theme-icon" aria-hidden="true" viewBox="0 0 24 24">
        <path d="M20 14.5A7.5 7.5 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z"></path>
      </svg>
    </button>
  </div>
  <label class="preference-control preference-control--language">
    <span class="preference-label">Language</span>
    <select data-language-select aria-label="Language">
      <option value="en" data-no-translate>English</option>
      <option value="es" data-no-translate>Español</option>
      <option value="zh-Hans" data-no-translate>简体中文</option>
      <option value="zh-Hant" data-no-translate>繁體中文</option>
    </select>
  </label>
</div>
